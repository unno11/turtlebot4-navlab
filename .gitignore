# ROS 2 / Colcon
build/
install/
log/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Large recorded data
*.db3
*.mcap
*.bag
*.bag.active

# Temporary files
*.swp
*.tmp
.DS_Store

# Local secrets
.env
.env.*

# Windows download metadata
*:Zone.Identifier

# Per-run results stay local; commit documentation and the header-only template.
/results/runs/
/results/summary.csv
/results/.experiment.lock

# Superseded batches are moved here rather than deleted, so the numbers behind an
# older result set can still be regenerated. Raw records either way - stay local.
/results/archive/

# Batch runner logs are raw run data, same rule as runs/ and summary.csv.
/results/batch_*.log
/results/ctl_*.log
